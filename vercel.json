{
  "version": 2,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "ek-island.vercel.app"
        }
      ],
      "status": 307,
      "headers": {
        "Location": "https://english-kombat.vercel.app/island"
      }
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
